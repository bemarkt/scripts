#!name = 酷安去广告
#!desc = 过滤酷安广告（支持评论过滤开关）
#!openUrl = https://apps.apple.com/app/id14225818691
#!author = RuCu6[https://github.com/RuCu6], ddgksf2013[https://github.com/ddgksf2013]
#!tag = 去广告
#!system = 
#!system_version = 
#!loon_version = 3.5.1(978)
#!homepage = https://github.com/bemarkt/scripts/blob/master/provider/Loon/README.md
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/CoolApk.png
#!date = 2026-08-04 00:00

[Argument]
filter_comments = switch,true,tag=过滤评论广告

[Rewrite]
# 热搜
request if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/search\?.*type=hotSearch/ then reject_dict(200)

# 动态详情与评论
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/feed\/detail\?/ && ${response.status} == 200 then response.json.jq("if (.data | type) == \"object\" then .data |= (if has(\"hotReplyRows\") then .hotReplyRows |= if type == \"array\" then map(select(.id != null)) else . end else . end | if has(\"topReplyRows\") then .topReplyRows |= if type == \"array\" then map(select(.id != null)) else . end else . end | .detailSponsorCard = [] | .include_goods = [] | .include_goods_ids = []) else . end")
response if ${filter_comments} == true && ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/feed\/replyList\?/ && ${response.status} == 200 then response.json.jq("if (.data | type) == \"array\" then .data |= map(select(.id != null)) else . end")

# 首页与数据列表
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/(main|page)\/dataList\?/ && ${response.status} == 200 then response.json.jq("if (.data | type) == \"array\" then .data |= map(select(.entityTemplate != \"sponsorCard\" and .entityTemplate != \"iconButtonGridCard\" and .entityTemplate != \"iconLargeScrollCard\" and .entityTemplate != \"imageScaleCard\" and ((.title // \"\") | contains(\"精选配件\") | not) and ((.title // \"\") | contains(\"酷安热搜\") | not) and ((.title // \"\") | contains(\"流量\") | not))) else . end")
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/indexV8\?/ && ${response.status} == 200 then response.json.jq("if (.data | type) == \"array\" then .data |= map(select(.entityTemplate != \"sponsorCard\" and .entityId != 8639 and .entityId != 29349 and .entityId != 33006 and .entityId != 32557 and .entityId != 944 and .entityId != 945 and .entityId != 6390 and ((.title // \"\") | contains(\"值得买\") | not) and ((.title // \"\") | contains(\"红包\") | not))) else . end")
response if ${url} ~= /^https:\/\/api\.coolapk\.com\/v6\/main\/init(?:\?|$)/ && ${response.status} == 200 then response.json.jq("if (.data | type) == \"array\" then .data |= map(select(.entityId != 8639 and .entityId != 29349 and .entityId != 33006 and .entityId != 32557 and .entityId != 944 and .entityId != 945 and .entityId != 6390) | if .entityId == 20131 and (.entities | type) == \"array\" then .entities |= map(select(.title != \"酷品\")) else . end) else . end")

[MitM]
hostname = api.coolapk.com
